{
  "name": "@urban/ralph",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "ralph": "./src/cli.ts"
  },
  "files": [
    "README.md",
    "examples/checklist-workflow/*.md",
    "src/**/*.ts",
    "src/templates/*.md"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "cli": "bun src/cli.ts",
    "lint": "oxfmt && oxlint --fix",
    "prepare": "effect-language-service patch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.93",
    "effect": "4.0.0-beta.93"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@effect/language-service": "0.86.4",
    "@effect/vitest": "4.0.0-beta.93",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{css,html,json,jsonc,md,mdx,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "bun": ">= 1.3.5",
    "node": ">= 24.12.0"
  },
  "packageManager": "bun@1.3.5"
}
